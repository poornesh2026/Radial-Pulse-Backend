# Radial Pulse API — local development settings.
# Copy to services/api/.env (git-ignored). NEVER commit real values.

APP_ENV=local
LOG_LEVEL=INFO
DEBUG=false

# Local PostgreSQL from docker compose (see /docker-compose.yml).
DATABASE_URL=postgresql+psycopg://radial:radial_local_only@localhost:5432/radial_pulse
# Tests against real PostgreSQL (nx run api:integration-test). Uses a separate database.
TEST_DATABASE_URL=postgresql+psycopg://radial:radial_local_only@localhost:5432/radial_pulse_test

# Web and mobile dev servers allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Cognito (use the DEV user pool; values are public identifiers, not secrets).
# Without these, protected endpoints return 503 "authentication not configured" — there is no bypass.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_IDS=
COGNITO_DOMAIN=

# S3 (DEV bucket). Credentials come from your AWS profile / SSO session, never from this file.
AWS_REGION=ap-south-1
S3_ASSETS_BUCKET=
